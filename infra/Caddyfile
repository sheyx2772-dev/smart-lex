# SmartLex — HTTPS reverse proxy (avtomatik Let's Encrypt).
# Domenlar {$APP_DOMAIN} / {$API_DOMAIN} — infra/.env dan keladi (compose orqali).
# Shart: ikkala domen DNS A-yozuvi 185.191.141.146'ga qaragan, 80/443 ochiq bo'lsin.
# One-ID redirect_uri HTTPS talab qiladi.

{$APP_DOMAIN}, www.{$APP_DOMAIN} {
	reverse_proxy web:3000
	encode gzip
}

{$API_DOMAIN} {
	reverse_proxy api:3001
	encode gzip
}
