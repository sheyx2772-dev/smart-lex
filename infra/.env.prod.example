# SmartLex PRODUCTION env — nusxa oling: cp infra/.env.prod.example infra/.env
# infra/.env git'ga TUSHMAYDI. Maxfiy qiymatlarни shu yerга yozing.

# ── Baza / infratuzilma parollari (o'zingiz kuchli qiymat qo'ying) ──
POSTGRES_PASSWORD=CHANGE_ME_strong_db_owner_password
APP_DB_PASSWORD=CHANGE_ME_strong_app_db_password
JWT_SECRET=CHANGE_ME_min_32_random_chars
S3_ACCESS_KEY=CHANGE_ME_minio_user
S3_SECRET_KEY=CHANGE_ME_minio_password

# ── Integratsiyalar (kelганда to'ldiring) ──
USE_MOCKS=true

# ── One-ID (uzinfokom bergan qiymatlar) ──
ONEID_CLIENT_ID=tijoraat_uz
ONEID_CLIENT_SECRET=CHANGE_ME_oneid_secret_from_uzinfokom
ONEID_SCOPE=CHANGE_ME_oneid_scope
# Tashkilot mavjud, foydalanuvchi yo'q bo'lsa avtomatik yaratilsinmi:
ONEID_AUTO_PROVISION=false
# Faqat "Tasdiqlangan" (ERI/Mobile-ID) / faqat E-IMZO (ERI) kirish:
ONEID_REQUIRE_VERIFIED=false
ONEID_REQUIRE_ERI=false
