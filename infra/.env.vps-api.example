# SmartLex — VPS API/worker uchun env (STANDALONE, Docker EMAS).
# Web Vercel'да, bu fayl faqat VPS'даги API + worker uchun.
# Nusxa: cp infra/.env.vps-api.example /path/to/api/.env   (yoki process manager env'iga)

NODE_ENV=production
API_PORT=3001

# ── Baza (VPS'даги mavjud Postgres) ──
DATABASE_URL=postgresql://lex_app:APP_PAROL@localhost:5432/lex
DATABASE_MIGRATION_URL=postgresql://OWNER:OWNER_PAROL@localhost:5432/lex
APP_DB_PASSWORD=APP_PAROL
REDIS_URL=redis://localhost:6379

# ── Auth / storage ──
JWT_SECRET=CHANGE_ME_min_32_random
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=lex-documents
USE_MOCKS=true

# ── One-ID (lexai.com.uz uchun ro'yxatdан o'tган) ──
WEB_URL=https://www.lexai.com.uz
ONEID_BASE_URL=https://sso.egov.uz/sso/oauth/Authorization.do
ONEID_CLIENT_ID=tijoraat_uz
ONEID_CLIENT_SECRET=CHANGE_ME_yangilangan_secret
ONEID_SCOPE=CHANGE_ME_scope
ONEID_REDIRECT_URI=https://api.lexai.com.uz/auth/oneid/callback
ONEID_POST_LOGIN_REDIRECT=https://www.lexai.com.uz
COOKIE_DOMAIN=.lexai.com.uz
ONEID_AUTO_PROVISION=false
ONEID_REQUIRE_VERIFIED=false
ONEID_REQUIRE_ERI=false
