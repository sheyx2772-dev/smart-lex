{
  "manifest_version": 3,
  "name": "SmartLex.AI — Avtomatik to'ldirish",
  "version": "0.7.0",
  "description": "SmartLex.AI da'vo/ariza ma'lumotlarini davlat saytlari (Gibrid pochta, xarid) formalariga avtomatik to'ldiradi. E-SUD (cabinet.sud.uz) endi bookmarklet orqali ulanadi. E-IMZO'ni foydalanuvchi o'zi tasdiqlaydi.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://adolat.sud.uz/*",
    "https://hybrid.pochta.uz/*",
    "https://xarid.uzex.uz/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "SmartLex.AI"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://lexai.com.uz/*",
        "https://www.lexai.com.uz/*",
        "https://app.lexai.com.uz/*",
        "https://smartlex.ai/*",
        "https://*.smartlex.ai/*"
      ],
      "js": [
        "src/relay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://adolat.sud.uz/*",
        "https://hybrid.pochta.uz/*",
        "https://xarid.uzex.uz/*"
      ],
      "js": [
        "src/profiles.js",
        "src/fill.js"
      ],
      "css": [
        "src/panel.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
