{
  "name": "debitor-ai",
  "version": "0.1.0",
  "private": true,
  "description": "DEBITOR AI — Autonomous Legal & Credit AI Agent for Uzbekistan",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @lex/db generate",
    "db:migrate": "pnpm --filter @lex/db migrate",
    "db:migrate:secrets": "pnpm --filter @lex/db migrate:secrets",
    "db:push": "pnpm --filter @lex/db push",
    "db:seed": "pnpm --filter @lex/db seed",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.5"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.11.1",
      "form-data": "^4.0.4",
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.18",
      "nanoid": ">=3.3.17"
    }
  }
}
