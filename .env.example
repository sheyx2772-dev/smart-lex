# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
# Mock adapterlardan foydalanish (Didox token / kalitlar kelmaguncha true)
USE_MOCKS=true

# ── Database ─────────────────────────────────────────────
# Ilova ulanishi — CHEKLANGAN rol (NOSUPERUSER NOBYPASSRLS) => RLS majburiy ishlaydi.
DATABASE_URL=postgresql://lex_app:lex_app@localhost:5433/lex
# Migratsiya/RLS bootstrap uchun owner (superuser) ulanishi.
DATABASE_MIGRATION_URL=postgresql://lex:lex@localhost:5433/lex
APP_DB_PASSWORD=lex_app

# ── Redis (BullMQ) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object storage (MinIO / S3) ──────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=lexminio
S3_SECRET_KEY=lexminio123
S3_BUCKET=lex-documents

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── AI ───────────────────────────────────────────────────
# AI_PROVIDER: anthropic | google
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Didox integratsiya (token kelganda to'ldiriladi) ─────
# Prod: https://api-partners.didox.uz  | Test: https://stage.goodsign.biz
DIDOX_API_URL=https://stage.goodsign.biz
DIDOX_PARTNER_TOKEN=

# ── API ──────────────────────────────────────────────────
API_PORT=3001
WEB_URL=http://localhost:3000

# ── SMS: Eskiz.uz (kalit kelganda REAL SMS) ─────
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_TOKEN=
SMS_FROM=4546
