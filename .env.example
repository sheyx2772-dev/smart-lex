# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
# Mock adapterlardan foydalanish (Didox token / kalitlar kelmaguncha true)
USE_MOCKS=true

# ── Database ─────────────────────────────────────────────
# Ilova ulanishi — CHEKLANGAN rol (NOSUPERUSER NOBYPASSRLS) => RLS majburiy ishlaydi.
DATABASE_URL=postgresql://lex_app:lex_app@localhost:5433/lex
# Migratsiya/RLS bootstrap uchun owner (superuser) ulanishi.
DATABASE_MIGRATION_URL=postgresql://lex:lex@localhost:5433/lex
APP_DB_PASSWORD=lex_app

# ── Redis (BullMQ) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object storage (MinIO / S3) ──────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=lexminio
S3_SECRET_KEY=lexminio123
S3_BUCKET=lex-documents

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── AI ───────────────────────────────────────────────────
# AI_PROVIDER: anthropic | google
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Didox integratsiya (token kelganda to'ldiriladi) ─────
# Prod: https://api-partners.didox.uz  | Test: https://stage.goodsign.biz
DIDOX_API_URL=https://stage.goodsign.biz
DIDOX_PARTNER_TOKEN=

# ── API ──────────────────────────────────────────────────
API_PORT=3001
WEB_URL=http://localhost:3000

# ── One-ID (SSO — sso.egov.uz) ───────────────────────────
# Kalitlar uzinfokom/Raqamli hukumatдан keladi. QIYMATLARNI BU YERGA YOZMANG —
# server .env (gitignore) fayliga qo'ying. Diqqat: redirect_uri "localhost" bo'lolmaydi
# va so'rovlar faqat whitelist IP (185.191.141.146) dan ketishi kerak.
ONEID_BASE_URL=https://sso.egov.uz/sso/oauth/Authorization.do
ONEID_CLIENT_ID=
ONEID_CLIENT_SECRET=
ONEID_REDIRECT_URI=https://api.tijoraat.uz/auth/oneid/callback
ONEID_SCOPE=
# Muvaffaqiyatli kirishдан keyin foydalanuvchi qaytariladigan web bosh sahifasi.
ONEID_POST_LOGIN_REDIRECT=https://tijoraat.uz
# LEX_TOKEN cookie'sini web bilan ulashish uchun ota-domen (mas. .tijoraat.uz). Lokalда bo'sh.
COOKIE_DOMAIN=
# Tashkilot bor, lekin foydalanuvchi yo'q bo'lsa — avtomatik yaratilsinmi (true/false).
ONEID_AUTO_PROVISION=false
# E-IMZO (ERI): faqat "Tasdiqlangan foydalanuvchi" (ERI/Mobile-ID) kirsinmi.
ONEID_REQUIRE_VERIFIED=false
# Faqat E-IMZO (ERI) bilan kirish shartmi (Mobile-ID/parol rad etiladi).
ONEID_REQUIRE_ERI=false
# Brauzer uchun ochiq API manzili (web /api/oneid shu yerga yo'naltiradi).
ONEID_PUBLIC_API_URL=https://api.tijoraat.uz

# ── SMS: Eskiz.uz (kalit kelganda REAL SMS) ─────
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_TOKEN=
SMS_FROM=4546
